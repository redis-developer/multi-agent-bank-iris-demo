# Copy to .env and fill in your key before `docker compose up -d`.

# --- LLM + embeddings (required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Point at a proxy / Azure endpoint if needed:
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Redis (your Redis Cloud database — Getting started, Step 1) ---
# REQUIRED. There is no local Redis: your cloud database is THE database —
# indexes, imported records, and memory all live in it, and the managed
# Iris services must be able to reach it. Copy the public endpoint and
# default-user password from your database's page in the Redis Cloud
# console, e.g.:
# REDIS_URL=redis://default:<password>@<public-endpoint-host>:<port>
REDIS_URL=

# --- Redis Context Retriever (Section 4 — schema-first data access) ---
# Filled automatically by `python -m src.context.bootstrap` (Section 4,
# step 3); Google/SSO accounts paste one from the console instead.
CTX_ADMIN_KEY=
# Endpoints default to the managed service; override only if told to:
# CTX_API_URL=
# CTX_MCP_URL=

# --- Redis LangCache (Section 6 — managed semantic caching) ---
# Created in the Redis Cloud console (https://cloud.redis.io -> LangCache).
# The Section 6 steps walk through it; leave blank until then.
LANGCACHE_URL=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
# Similarity threshold used on cache lookups (0-1; higher = stricter)
CACHE_SIMILARITY_THRESHOLD=0.85
